@model List<PecasModel>
@{
    ViewData["title"] = "Pecas no estoque";
}

<div class="text-center">

    <h1 class="display-4">Peças no estoque</h1>
    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <a role="button" class="btn btn-primary" asp-action="Adicionar" asp-controller="Estoque">Adicionar novo contato</a>
    </div>
       
    <br/>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Codigo</th>
                <th scope="col">Nome da Peça</th>
                <th scope="col">Fornecedor</th>
                <th scope="col">Quantidade Atual</th>
                <th scope="col">Localização</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null && Model.Any())
            {
                foreach(PecasModel peca in Model)
                {
                    <tr>
                        <th scope="row">@peca.Id</th>
                        <td>@peca.Codigo</td>
                        <td>@peca.Nome</td>
                        <td>@peca.Fornecedor</td>
                        <td>@peca.Quantidade</td>
                        <td>@peca.Localizacao</td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Basic example">
                                <a role="button" class="btn btn-primary" asp-route-Id="@peca.Id" asp-action="Editar" asp-controller="Estoque">Editar</a>
                                <a role="button" class="btn btn-danger" asp-route-Id="@peca.Id" asp-action="Apagarconfirmacao" asp-controller="Estoque">Apagar</a>
                            </div>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>

</div>