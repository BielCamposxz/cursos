@model PecasModel
@{
    ViewData["title"] = "Adicionar peça";
}

<div class="text-center">
    <h1 class="display-4">Adicionar peça no estoque</h1>
</div>

<form asp-action="Adicionar" asp-controller="Estoque" method="post">
    <div class="mb-3">
        <label for="codigo" class="form-label">Codigo da peça</label>
        <input type="text" class="form-control" placeholder="Digite o codigo da peça" id="codigo" asp-for="Codigo">
    </div>
    <div class="mb-3">
        <label for="Nome" class="form-label">Nome da Peça</label>
        <input type="text" class="form-control" placeholder="Digite o nome da peça" id="Nome" asp-for="Nome">
    </div>
    <div class="mb-3">
        <label for="fornecedor" class="form-label">Fornecedor</label>
        <input type="text" class="form-control" placeholder="Digite o fornecedor da peça" id="fornecedor" asp-for="Fornecedor">
    </div>
    <div class="mb-3">
        <label for="quantidade" class="form-label">Quantidade de peça em estoque</label>
        <input type="text" class="form-control" placeholder="Digite a Quantidade da peça em estoque" id="quantidade" asp-for="Quantidade">
    </div>
    <div class="mb-3">
        <label for="localizacao" class="form-label">Localização da peça no estoque</label>
        <input type="text" class="form-control" placeholder="Digite a localização da peça no estoque" id="localizacao" asp-for="Localizacao">
    </div>


    <button type="submit" class="btn btn-primary">Adicionar</button>
    <a class="btn btn-secondary" role="button" asp-action="Index" asp-controller="Estoque">Voltar</a>
</form>
