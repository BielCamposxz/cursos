@{
    ViewData["title"] = "Apagar peça";
}

<div class="text-center">
    <h1 class="display-4" style="color:red;">Atencao!!!</h1>
    <h3>Deseja apagar a peca (freios) do estoque?</h3>
    <a role="button" class="btn btn-danger d-block d-grid gap-2 mb-1" asp-action="Apagarconfirmacao" asp-controller="Estoque">Excluir</a>
    <a role="button" class="btn btn-primary d-block d-grid gap-2 mb-1" asp-action="Index" asp-controller="Estoque">Voltar</a>
</div>

